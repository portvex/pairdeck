#!/bin/sh
# Installed by cargo-husky. Full checks before pushing.
set -e
echo "pre-push: cargo test"
cargo test --locked
if command -v cargo-audit >/dev/null 2>&1; then
    echo "pre-push: cargo audit"
    cargo audit
else
    echo "pre-push: cargo-audit not installed, skipping (cargo install cargo-audit)"
fi
if command -v cargo-deny >/dev/null 2>&1; then
    echo "pre-push: cargo deny check"
    cargo deny check
else
    echo "pre-push: cargo-deny not installed, skipping (cargo install cargo-deny)"
fi
